# The Rust extension ddtrace.internal.native._native (src/native), built with crate2nix: one
# buildRustCrate derivation per crate, so crates compile in parallel, are cached individually, and
# are shared between interpreters (only the pyo3 crates and the root crate see Python).
#
#   cargo-nix  Cargo.nix generated by crate2nix from a skeleton of the manifests and lock file, so
#              source edits do not regenerate it
#   crates     the generated crate set; root is the ddtrace-native crate itself
#   module     the cdylib, laid out as ddtrace/internal/native/_native<EXT_SUFFIX>
#   headers    the cbindgen headers the profiling C++ code includes (see ./native-headers.nix)
#   stub       an interface-only copy of the module (Linux) that the C++ code links against
#
# The stub holds only the dynamic symbol table, so a Rust change that does not alter the exported
# symbols reproduces it byte for byte, and content addressing then skips relinking dd_wrapper.
{
  lib,
  pkgs,
  stdenv,
  runCommand,
  mkCargoNix,
  defaultCrateOverrides,
  llvmPackages,
  patchelf,
  common,
  root,
  python,
  serverless,
  native-headers,
  helpers,
}:
let
  inherit (stdenv.hostPlatform) isLinux isDarwin is64bit;
  nativeDir = root + "/src/native";

  # Mirrors rust_features in setup.py.
  profiling = (isLinux || isDarwin) && is64bit && lib.versionOlder python.pythonVersion "3.16";
  features = [
    "stats"
  ]
  ++ lib.optional profiling "profiling"
  ++ lib.optional (profiling && !serverless) "crashtracker"
  ++ lib.optional (!serverless) "ffe";

  # What `cargo metadata` needs to describe the workspace: manifests, the lock file and empty files
  # where cargo infers targets. Content addressed, so only manifest or lock changes rerun crate2nix.
  skeleton = runCommand "ddtrace-native-cargo-skeleton" common.caAttrs ''
    mkdir -p $out/native_proc_macro/src
    cp ${nativeDir + "/Cargo.toml"} $out/Cargo.toml
    cp ${nativeDir + "/Cargo.lock"} $out/Cargo.lock
    cp ${nativeDir + "/native_proc_macro/Cargo.toml"} $out/native_proc_macro/Cargo.toml
    touch $out/lib.rs $out/build.rs $out/native_proc_macro/src/lib.rs
  '';

  cargo-nix = mkCargoNix {
    name = "ddtrace-native";
    src = skeleton;
    lockFile = nativeDir + "/Cargo.lock";
  };

  sources = {
    ddtrace-native = lib.fileset.toSource {
      root = nativeDir;
      fileset = lib.fileset.difference nativeDir (nativeDir + "/native_proc_macro");
    };
    native-proc-macro = lib.fileset.toSource {
      root = nativeDir + "/native_proc_macro";
      fileset = nativeDir + "/native_proc_macro";
    };
  };

  # src/native/Cargo.toml's [profile.release], plus .cargo/config.toml's relocation model.
  releaseFlags = [
    "-C"
    "opt-level=s"
    "-C"
    "relocation-model=pic"
  ];

  # Cargo exposes a build script's `cargo:KEY=VALUE` lines to dependents as DEP_<links>_KEY, but
  # buildRustCrate names them after the crate (DEP_PYO3_FFI_* rather than pyo3-ffi's
  # DEP_PYTHON_*). Add the names cargo would use.
  linksMetadata =
    crate:
    let
      links = lib.toUpper (lib.replaceStrings [ "-" ] [ "_" ] crate.links);
    in
    lib.optionalString (crate ? links) ''
      if [ -e target/env ]; then
        prefix="DEP_$(echo "$CRATENAME" | tr '[:lower:]' '[:upper:]')_"
        sed -n "s/^export $prefix/export DEP_${links}_/p" target/env > target/env.links
        cat target/env.links >> target/env
      fi
    '';

  pythonEnv = {
    nativeBuildInputs = [ python ];
    PYO3_PYTHON = python.interpreter;
  };

  # crate2nix resolves `dep:rustls` in reqwest's rustls-no-provider feature as reqwest's own
  # `rustls` feature, which selects the aws-lc-rs TLS provider and propagates aws-lc-rs features
  # to the rustls crates. Cargo does not (aws-lc-rs is not even in Cargo.lock), so drop them.
  awsLcFeatures = {
    reqwest = [
      "rustls"
      "__rustls-aws-lc-rs"
    ];
    rustls = [
      "aws_lc_rs"
      "aws-lc-rs"
      "prefer-post-quantum"
      "fips"
    ];
    rustls-webpki = [
      "aws-lc-rs"
      "aws-lc-rs-fips"
      "aws-lc-rs-unstable"
    ];
    hyper-rustls = [
      "aws-lc-rs"
      "fips"
    ];
    tokio-rustls = [
      "aws-lc-rs"
      "fips"
    ];
  };

  crateOverrides =
    defaultCrateOverrides
    // lib.mapAttrs (
      _: unwanted: attrs: { features = lib.subtractLists unwanted (attrs.features or [ ]); }
    ) awsLcFeatures
    // {
    # Header generation is a separate derivation (native-headers.nix); without the feature,
    # build_common's generate_and_configure_header is a no-op in libdatadog's build scripts.
    build_common = attrs: {
      features = lib.remove "cbindgen" (attrs.features or [ ]);
    };

    # Bundle zstd like the CI wheels, instead of nixpkgs' default of linking the system library.
    zstd-sys = _: { };

    pyo3-build-config = _: pythonEnv;
    pyo3-ffi = _: pythonEnv;
    pyo3 = _: pythonEnv;
    pyo3-macros-backend = _: pythonEnv;

    native-proc-macro = _: { src = sources.native-proc-macro; };

    ddtrace-native = attrs: {
      src = sources.ddtrace-native;
      # build.rs links with lld on Linux; the wrapped lld keeps Nix's RUNPATH handling.
      nativeBuildInputs =
        (attrs.nativeBuildInputs or [ ])
        ++ pythonEnv.nativeBuildInputs
        ++ lib.optional isLinux llvmPackages.bintools;
      inherit (pythonEnv) PYO3_PYTHON;
      extraRustcOpts = (attrs.extraRustcOpts or [ ]) ++ [
        "-C"
        "lto=fat"
        "-C"
        "codegen-units=1"
      ];
    };
  };

  # Overrides go through buildRustCrate itself: Cargo.nix would otherwise call `.override` on
  # the function returned here.
  crates = import cargo-nix {
    inherit pkgs;
    rootFeatures = features;
    buildRustCrateForPkgs =
      pkgs:
      let
        buildRustCrate = pkgs.buildRustCrate.override { defaultCrateOverrides = crateOverrides; };
      in
      crate:
      (buildRustCrate (
        crate
        // {
          extraRustcOpts = (crate.extraRustcOpts or [ ]) ++ releaseFlags;
          postConfigure = (crate.postConfigure or "") + linksMetadata crate;
        }
      )).overrideAttrs
        (_: common.caAttrs);
  };

  rootCrate = crates.rootCrate.build;

  module = stdenv.mkDerivation (
    {
      pname = "ddtrace-native";
      inherit (common) version stripDebugList;

      dontUnpack = true;
      dontConfigure = true;
      dontBuild = true;

      nativeBuildInputs = lib.optional isLinux patchelf;

      installPhase = ''
        runHook preInstall
        ${common.pythonVars python}
        name="_native$EXT_SUFFIX"
        dest="$out/ddtrace/internal/native"
        mkdir -p "$dest"
        cp ${rootCrate.lib}/lib/lib_native${stdenv.hostPlatform.extensions.sharedLibrary} "$dest/$name"
        chmod u+w "$dest/$name"
      ''
      # setup.py sets the SONAME / install name so dependents record the module's own file name.
      + lib.optionalString isLinux ''
        patchelf --set-soname "$name" "$dest/$name"
      ''
      + lib.optionalString isDarwin ''
        install_name_tool -id "$name" "$dest/$name"
      ''
      + ''
        runHook postInstall
      '';
    }
    // common.caAttrs
  );

  stub = helpers.mkInterfaceStub "ddtrace-native" module;
in
{
  inherit
    cargo-nix
    crates
    module
    stub
    features
    profiling
    ;
  root = rootCrate;
  headers = native-headers;
}
