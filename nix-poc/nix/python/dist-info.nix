# The wheel's .dist-info (METADATA, entry points, licenses), generated by setuptools from
# pyproject.toml alone. Shared by every interpreter; WHEEL and RECORD are added by wheel.nix.
{
  lib,
  stdenvNoCC,
  python3,
  common,
  root,
  serverless,
}:
stdenvNoCC.mkDerivation (
  {
    pname = "ddtrace-dist-info";
    inherit (common) version;

    src = common.src [
      (root + "/pyproject.toml")
      (root + "/README.md")
      # setuptools' default license-files patterns pick these up.
      (root + "/LICENSE")
      (root + "/LICENSE.Apache")
      (root + "/LICENSE.BSD3")
      (root + "/NOTICE")
    ];

    nativeBuildInputs = [ (python3.withPackages (ps: [ ps.setuptools ])) ];

    dontConfigure = true;
    dontFixup = true;

    # setup.py renames the project the same way for serverless builds.
    postPatch = lib.optionalString serverless ''
      sed -i -e 's/^name = ".*"/name = "ddtrace-serverless"/' pyproject.toml
    '';

    buildPhase = ''
      runHook preBuild
      mkdir -p metadata "$out"
      python -c 'import sys; from setuptools import build_meta; build_meta.prepare_metadata_for_build_wheel(sys.argv[1])' metadata
      echo ddtrace > metadata/*.dist-info/top_level.txt
      mv metadata/*.dist-info "$out"/
      runHook postBuild
    '';
  }
  // common.caAttrs
)
