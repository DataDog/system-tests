{% macro copy_binaries(path) %}
    - section_start "copy_binaries" "Copying pre-built binaries into binaries/"
    - mkdir -p binaries
    - cp -r "$CI_PROJECT_DIR/{{path}}/." binaries/
    - ls -la binaries/
    - section_end "copy_binaries"
{% endmacro %}
{% macro job_tag(tag) %}
    - datadog-ci tag --level job --tags "system-tests.job_type:{{tag}}"
{% endmacro %}
{% macro emit_execution_time_metric() %}
    - |
      if [[ "$SYSTEM_TESTS_GENERATED_PIPELINE_START_TIME" =~ ^[0-9]+$ ]]; then
        elapsed=$(( $(date +%s) - SYSTEM_TESTS_GENERATED_PIPELINE_START_TIME ))
        datadog-ci measure --level job --measures system-tests.total_duration:$elapsed
      else
        echo "SYSTEM_TESTS_GENERATED_PIPELINE_START_TIME not set or not numeric ('$SYSTEM_TESTS_GENERATED_PIPELINE_START_TIME'), skipping metric emission"
      fi
{% endmacro %}
{% if not skip_header %}
workflow:
  name: "System-tests end to end"

include:
  - project: 'DataDog/system-tests'
    ref: {{ref}}
    file: 'utils/ci/gitlab/templates.yml'
    inputs:
      stage: {{stage}}
      ref: {{ref}}

default:
  retry:
    max: 2
    when:
      - runner_system_failure
      - scheduler_failure
      - stuck_or_timeout_failure
      - unknown_failure
      - data_integrity_failure
    exit_codes:
      - 255

stages:
  - {{stage}}

variables:
  CI_IMAGE: {{ci_image}}
  SYSTEM_TESTS_GENERATED_PIPELINE_START_TIME: "{{pipeline_start_time}}"

.push_to_test_optimization:
  id_tokens:
    DD_STS_OIDC_TOKEN:
      aud: dd-sts
  after_script:
    - echo -e "section_start:$(date +%s):test_optim[collapsed=true]\r\e[0KPush to tests optimization"
    - source "dd_api_key.env"
    - dd-sts debug
    - >
      datadog-ci junit upload system-tests/logs*/reportJunit.xml
      --service system-tests
      --env ci
      --xpath-tag "test.codeowners=/testcase/properties/property[@name='test.codeowners']"
    - echo -e "section_end:$(date +%s):test_optim\r\e[0K"

setup:
  extends: .system_tests_base
  tags: ["arch:amd64"]
  id_tokens:
    DD_STS_OIDC_TOKEN:
      aud: dd-sts
  script:
    - datadog-ci tag --level pipeline --tags "system-tests:true"
{% endif %}

{% for variant in weblog_variants %}
system_tests_build_{{library}}_{{variant}}:
  extends: .system_tests_base
  id_tokens:
    DD_STS_OIDC_TOKEN:
      aud: dd-sts
  {% if binaries_artifacts_list %}
  needs:
    {% for artifact_job in binaries_artifacts_list %}
    - job: "{{artifact_job}}"
      artifacts: true
      pipeline: $UPSTREAM_PIPELINE_ID
    {% endfor %}
  {% endif %}
  script:
    {% if binaries_artifacts_list and binaries_artifact_path %}
    {{ copy_binaries(binaries_artifact_path) }}
    {% endif %}
    - section_start "build" "Building weblog" false
    {{ job_tag("build") }}
    - {{ render_build(library, variant) }}
    - mv binaries ..
    - section_end "build"
  artifacts:
    paths:
      - binaries/

{% endfor %}
{% for variant, scenario, build_required in scenario_pairs %}
system_tests_run_{{library}}_{{scenario}}_{{variant}}:
  timeout: 15 minutes
  variables:
    KUBERNETES_CPU_REQUEST: 0.5
    KUBERNETES_MEMORY_REQUEST: 1.3Gi
  extends:
    - .system_tests_base
{% if push_to_test_optimization %}
    - .push_to_test_optimization
{% endif %}
  id_tokens:
    DD_STS_OIDC_TOKEN:
      aud: dd-sts
  needs:
  {% if build_required %}
    - job: system_tests_build_{{library}}_{{variant}}
      artifacts: true
  {% elif binaries_artifacts_list %}
    {% for artifact_job in binaries_artifacts_list %}
    - job: "{{artifact_job}}"
      artifacts: true
      pipeline: $UPSTREAM_PIPELINE_ID
    {% endfor %}
  {% endif %}
  script:
    - section_start "weblog_setup" "Setting up the weblog"
    {% if build_required %}
    - mv ../binaries/* binaries/
    {% elif binaries_artifacts_list and binaries_artifact_path %}
    {{ copy_binaries(binaries_artifact_path) }}
    {% endif %}
    - section_end "weblog_setup"
    - section_start "scenario_run" "Running scenario" false
    {{ job_tag("run") }}
    {% if build_required %}
    - {{ trace("build " ~ library ~ " " ~ variant, "./build.sh " ~ library ~ " -i weblog --weblog-variant " ~ variant, library, weblog=variant) }}
    {% endif %}
    {% if scenario == "INTEGRATION_FRAMEWORKS" %}
    - {{ trace("run " ~ library ~ " " ~ scenario ~ " " ~ variant, "./run.sh " ~ scenario ~ " -L " ~ library ~ " --weblog " ~ variant, library, weblog=variant, scenario=scenario) }}
    {% elif scenario in ("GO_PROXIES_DEFAULT", "GO_PROXIES_APPSEC_BLOCKING") %}
    - {{ trace("run " ~ library ~ " " ~ scenario ~ " " ~ variant, "./run.sh " ~ scenario ~ " --weblog " ~ variant, library, weblog=variant, scenario=scenario) }}
    {% else %}
    - {{ trace("run " ~ library ~ " " ~ scenario ~ " " ~ variant, "./run.sh " ~ scenario, library, weblog=variant, scenario=scenario) }}
    {% endif %}
    - section_end "scenario_run"
    {{ emit_execution_time_metric() }}
  artifacts:
    when: always
    paths:
      - system-tests/logs*

{% endfor %}
{% if parametric.enable %}
{% for job_index in parametric.job_matrix %}
system_tests_run_{{library}}_PARAMETRIC_{{job_index}}:
  extends:
    - .system_tests_base
{% if push_to_test_optimization %}
    - .push_to_test_optimization
{% endif %}
  id_tokens:
    DD_STS_OIDC_TOKEN:
      aud: dd-sts
  {% if binaries_artifacts_list %}
  needs:
    {% for artifact_job in binaries_artifacts_list %}
    - job: "{{artifact_job}}"
      artifacts: true
      pipeline: $UPSTREAM_PIPELINE_ID
    {% endfor %}
  {% endif %}
  script:
    - section_start "run" "Running PARAMETRIC (group {{job_index}}/{{parametric.job_count}})" false
    {{ job_tag("run") }}
    {% if binaries_artifacts_list and binaries_artifact_path %}
    {{ copy_binaries(binaries_artifact_path) }}
    {% endif %}
    - {{ trace("run " ~ library ~ " PARAMETRIC " ~ job_index, "./run.sh PARAMETRIC -L " ~ library ~ " --splits=" ~ parametric.job_count ~ " --group=" ~ job_index, library, scenario="PARAMETRIC") }}
    - section_end "run"
    {{ emit_execution_time_metric() }}
  artifacts:
    when: always
    paths:
      - system-tests/logs*

{% endfor %}
{% endif %}
