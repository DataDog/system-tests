[importlinter]
root_packages =
    tests
    utils
include_external_packages = True
contract_types =
    no-cross-test-imports: utils.format.import_linter_contracts.NoCrossTestImportsContract

[importlinter:contract:pytest-facade]
name = Tests use the approved pytest facade
type = forbidden
source_modules =
    tests
forbidden_modules =
    pytest
allow_indirect_imports = True

[importlinter:contract:no-cross-test-imports]
name = Test files do not import other test files
type = no-cross-test-imports
ignore_imports =
    tests.appsec.api_security.test_apisecurity_telemetry -> tests.appsec.api_security.test_schemas
    tests.appsec.waf.test_blocking -> tests.appsec.waf.test_blocking_security_response_id
    tests.docker_ssi.test_docker_ssi -> tests.parametric.test_telemetry
    tests.docker_ssi.test_docker_ssi_appsec -> tests.parametric.test_telemetry
    tests.parametric.test_ffe.test_configuration_sources -> tests.parametric.test_ffe.test_dynamic_evaluation
    tests.parametric.test_parametric_endpoints -> tests.parametric.test_dynamic_configuration
    tests.test_telemetry -> tests.test_telemetry_heartbeat_utils
    tests.test_the_test.test_telemetry_heartbeat -> tests.test_telemetry_heartbeat_utils
    tests.test_the_test.test_ffe_tests -> tests.ffe.test_exposure_egress
    tests.test_the_test.test_ffe_tests -> tests.ffe.test_flag_eval_evp
    tests.test_the_test.test_otlp_request_correlation -> tests.otel.test_tracing_otlp
    tests.parametric.otel_env_vars.test_otel_logs_exporter -> tests.parametric.test_otel_logs

[importlinter:contract:utils-no-tests]
name = utils does not import tests
type = forbidden
source_modules =
    utils
forbidden_modules =
    tests
unmatched_ignore_imports_alerting = error
ignore_imports =
    # TODO: move cws_self_test_succeeded out of tests/
    utils._context._scenarios.thread_context_sharing -> tests.cws.utils

[importlinter:contract:utils-public-interface]
name = Tests only import utils through its public interface (utils/__init__.py)
type = protected
protected_modules =
    utils.*
allowed_importers =
    utils
unmatched_ignore_imports_alerting = error
ignore_imports =
    # public submodules
    tests.** -> utils.pytest
    tests.** -> utils.interfaces
    tests.** -> utils.waf_rules
    # tests of the framework itself test its internals
    tests.test_the_test.** -> utils.**
    # TODO: existing imports of internals, to migrate to `from utils import ...`
    tests.ai_guard.test_ai_guard_sdk -> utils._weblog
    tests.ai_guard.test_ai_guard_sdk -> utils.dd_constants
    tests.ai_guard.test_ai_guard_sdk -> utils.dd_types
    tests.apm_tracing_e2e.test_otel -> utils.dd_types
    tests.apm_tracing_e2e.test_process_tags -> utils.interfaces._library.miscs
    tests.apm_tracing_e2e.test_single_span -> utils.dd_constants
