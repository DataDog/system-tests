{
  "schemaVersion": 1,
  "kind": "sequence",
  "id": "failed-refresh-after-opt-out",
  "description": "A failed excluded refresh cannot restore an eligible assignment from the previous participation state.",
  "steps": [
    {
      "action": "configure",
      "providerOptions": {
        "enableExperimentationOptOutParameter": true
      }
    },
    {
      "action": "set-context",
      "context": {
        "targetingKey": "subject-2",
        "attributes": {
          "dd_experimentation_opt_out": false
        }
      },
      "expectedPublishedCase": null
    },
    {
      "action": "start-request",
      "requestId": "eligible",
      "expectedEvaluationOptions": null
    },
    {
      "action": "deliver-response",
      "requestId": "eligible",
      "caseId": "activation-enabled-false",
      "acknowledgement": "missing",
      "expectedAccepted": true,
      "expectedPublishedCase": "activation-enabled-false"
    },
    {
      "action": "evaluate",
      "caseId": "activation-enabled-false",
      "expectedValue": "experimental-control",
      "expectedExposureCount": 1,
      "expectedEvaluationTelemetry": true
    },
    {
      "action": "set-context",
      "context": {
        "targetingKey": "subject-2",
        "attributes": {
          "dd_experimentation_opt_out": true
        }
      },
      "expectedPublishedCase": null
    },
    {
      "action": "start-request",
      "requestId": "excluded",
      "expectedEvaluationOptions": {
        "experimentation_opt_out": true
      }
    },
    {
      "action": "fail-request",
      "requestId": "excluded",
      "expectedPublishedCase": null
    },
    {
      "action": "evaluate",
      "caseId": null,
      "expectedValue": "application-default",
      "expectedExposureCount": 0,
      "expectedEvaluationTelemetry": true
    }
  ],
  "flag": "two-arm",
  "defaultValue": "application-default"
}
