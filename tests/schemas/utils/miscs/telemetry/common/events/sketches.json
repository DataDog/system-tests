{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "/miscs/telemetry/common/events/sketches.json",
    "description": "sketches schema",
    "title": "sketches",
    "type": "object",
    "properties": {
        "namespace": {
            "type": "string"
        },
        "series": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "namespace": { "type": "string" },
                    "metric": { "type": "string" },
                    "tags": { "type": "array", "items": { "type": "string" } },
                    "common": { "type": "boolean" },
                    "interval": { "type": "number" },
                    "type": { "enum": ["distribution"] },
                    "sketch_b64": { "type": "string" },
                    "sketch_bytes": {}
                },
                "required": ["metric"],
                "oneOf": [
                    { "required": ["sketch_b64"] },
                    { "required": ["sketch_bytes"] }
                ]
            }
        }
    },
    "required": ["series"]
}
