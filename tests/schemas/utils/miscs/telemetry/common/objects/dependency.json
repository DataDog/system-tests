{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/miscs/telemetry/common/objects/dependency.json",
  "description": "Dependency Object",
  "title": "Instrumentation Telemetry Dependency",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "hash": {
      "type": ["string", "null"]
    },
    "type": {
      "enum": ["SharedSystemLibrary", "PlatformStandard"],
      "example": "SharedSystemLibrary"
    },
    "version": {
      "type": ["string", "null"]
    },
    "metadata": {
      "description": "SCA metadata; `value` is an opaque stringified-JSON payload",
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["type", "value"]
      }
    }
  },
  "required": ["name"]
}
