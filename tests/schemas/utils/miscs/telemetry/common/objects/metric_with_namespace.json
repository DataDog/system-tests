{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/miscs/telemetry/common/objects/metric_with_namespace.json",
  "description": "Metric Object With Namespace",
  "title": "Instrumentation Telemetry Metric",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string"
    },
    "common": {
      "type": "boolean"
    },
    "metric": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "description": "Metric type variant",
      "enum": [
        "gauge",
        "count",
        "rate",
        "distribution"
      ],
      "example": "gauge"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "interval": {
      "description": "Set for gauge and rate metric types",
      "type": "number",
      "format": "double"
    }
  },
  "required": [
    "namespace",
    "metric",
    "points"
  ],
  "allOf": [
    {
      "$comment": "gauge and rate are the metric types that carry an interval (see the field's description): a rate is only interpretable relative to the period it was measured over, and a gauge reports the value observed over the flush interval.",
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "gauge",
              "rate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "interval"
        ]
      }
    }
  ]
}
