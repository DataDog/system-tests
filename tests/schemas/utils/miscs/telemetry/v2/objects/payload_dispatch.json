{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/miscs/telemetry/v2/objects/payload_dispatch.json",
  "description": "Maps a v2 request_type to the schema of its payload",
  "title": "Instrumentation Telemetry V2 payload dispatch",
  "type": "object",
  "allOf": [
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-started" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/app-started.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-extended-heartbeat" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/extended-heartbeat.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-integrations-change" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/integrations-change.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-dependencies-loaded" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/dependencies-loaded.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-client-configuration-change" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/client-configuration-change.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-product-change" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/product-change.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "app-endpoints" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/app-endpoints.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "generate-metrics" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/generate-metrics.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "distributions" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/distributions.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "sketches" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/sketches.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "apm-onboarding-event" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/common/events/apm-onboarding.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "logs" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/logs.json" } } }
    },
    {
      "if": { "required": ["request_type"], "properties": { "request_type": { "const": "message-batch" } } },
      "then": { "properties": { "payload": { "$ref": "/miscs/telemetry/v2/events/message-batch.json" } } }
    }
  ]
}
