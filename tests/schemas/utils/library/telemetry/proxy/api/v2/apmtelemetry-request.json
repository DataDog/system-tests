{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/library/telemetry/proxy/api/v2/apmtelemetry-request.json",
  "description": "Instrumentation telemetry schema",
  "$comment": "api_version is required so that exactly one of the v1/v2 branches applies. Without it an absent api_version made both `if`s pass vacuously and the payload was validated against v1 AND v2 simultaneously.",
  "type": "object",
  "allOf": [
    {
      "required": ["api_version"],
      "properties": {
        "api_version": {
          "enum": ["v1", "v2"]
        }
      }
    },
    {
      "if": {
        "required": ["api_version"],
        "properties": {
          "api_version": {
            "const": "v1"
          }
        }
      },
      "then": {
        "$ref": "/miscs/telemetry/v1/telemetry_request.json"
      }
    },
    {
      "if": {
        "required": ["api_version"],
        "properties": {
          "api_version": {
            "const": "v2"
          }
        }
      },
      "then": {
        "$ref": "/miscs/telemetry/v2/telemetry_request.json"
      }
    }
  ]
}
